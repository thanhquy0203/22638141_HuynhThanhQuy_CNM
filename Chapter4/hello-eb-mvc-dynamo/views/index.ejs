<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Todo App</title>
<link rel="stylesheet" href="/styles.css">
</head>

<body>

<div class="container">

<h1>📝 Todo App</h1>

<form class="todo-form" method="POST" action="/add">
<input name="title" placeholder="Enter new task..." required>
<button type="submit">Add</button>
</form>

<ul class="todo-list">

<% todos.forEach(todo => { %>

<li class="todo-item <%= todo.done ? 'done' : '' %>">

<form method="POST" action="/toggle" class="toggle-form">
<input type="hidden" name="todoId" value="<%= todo.todoId %>">
<button class="toggle-btn">
<%= todo.done ? "✅" : "⬜" %>
</button>
</form>

<span class="todo-title"><%= todo.title %></span>

</li>

<% }) %>

</ul>

</div>

</body>
</html>